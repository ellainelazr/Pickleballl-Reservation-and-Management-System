@startuml
skinparam classAttributeIconSize 0

class PickleballMain {
  - courts: ArrayList<Court>
  - reservations: ArrayList<Reservation>
  - completedArchive: ArrayList<Reservation>
  - staffPasswords: Map<String,String>
  - customerPasswords: Map<String,String>
  - reservationHistory: ReservationHistory
  - waitingListQueue: CustomQueue<WaitingListEntry>
  + main(args: String[])
}

abstract class User {
  - name: String
  + getName(): String
  + setName(name: String): void
  + getRole(): String
}

class Admin extends User
class Staff extends User {
  - staffId: String
  - active: boolean
}
class Customer extends User

class Court {
  - courtName: String
  - regularRatePerHour: double
  - peakRatePerHour: double
  - available: boolean
}

class Reservation {
  - customerName: String
  - courtName: String
  - reservationDate: String
  - timeSlot: String
  - paymentStatus: String
  - bookingReference: String
  - totalPrice: double
  - rentedItems: ArrayList<RentalRecord>
}

class RentalItem {
  - name: String
  - hourlyRate: double
  - totalStock: int
}

class RentalRecord {
  - itemName: String
  - hourlyRate: double
  - quantity: int
}

class AuthService {
  + registerAccount(username:String, password:String, role:String): boolean
  + authenticate(username:String, password:String): String
  + changePassword(username:String, currentPassword:String, newPassword:String, confirmPassword:String): boolean
  + unlockAccount(username:String): boolean
}

class PasswordHashUtil {
  + hashPassword(password:String): String[]
  + matches(password:String, salt:String, hash:String): boolean
}

class FileStorageService {
  + saveAccounts(accountsByUsername: Map<String,String>, staffByUsername: Map<String,Staff>): void
  + loadAccounts(): Map<String,String>
  + loadStaffDetails(): Map<String,Staff>
  + saveReservations(reservations: ArrayList<Reservation>): void
  + loadReservations(): ArrayList<Reservation>
}

class ReservationHistory {
  - entries: SinglyLinkedList<ReservationActivityEntry>
  + recordActivity(message:String): void
}

class ReservationActivityEntry {
  - message: String
  - timestamp: String
}

class WaitingListEntry {
  - customerName: String
  - courtName: String
  - date: String
  - timeSlot: String
  - requestedAt: String
}

class SinglyLinkedList<T> {
  - head: Node<T>
  - tail: Node<T>
  - size: int
  + addFirst(value:T): void
  + addLast(value:T): void
  + removeFirst(): boolean
  + removeLast(): boolean
  + remove(value:T): boolean
  + find(value:T): T
  + size(): int
}

class CustomStack<T> {
  - storage: SinglyLinkedList<T>
  + push(value:T): void
  + pop(): T
  + peek(): T
  + size(): int
}

class CustomQueue<T> {
  - storage: SinglyLinkedList<T>
  + enqueue(value:T): void
  + dequeue(): T
  + peek(): T
  + size(): int
}

PickleballMain --> Court
PickleballMain --> Reservation
PickleballMain --> RentalItem
PickleballMain --> ReservationHistory
PickleballMain --> CustomQueue
PickleballMain --> AuthService
PickleballMain --> FileStorageService

Reservation --> RentalRecord
ReservationHistory --> ReservationActivityEntry
CustomQueue --> WaitingListEntry
SinglyLinkedList --> "0..*" ReservationActivityEntry
AuthService --> PasswordHashUtil
FileStorageService --> Reservation
@enduml
